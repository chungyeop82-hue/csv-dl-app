# GHCR(GitHub Container Registry)에 올린 이미지 경로를 지정한다.
# 이 파일을 같은 폴더에 ".env" 라는 이름으로 복사한 뒤 아래 값을 실제 값으로 바꾼다.
# (학생에게 배포하기 전에, 배포 담당자가 딱 한 번 해두면 된다. 학생은 이 파일을 건드릴 필요가 없다.)
#
# 예: 저장소가 https://github.com/OWNER/csv-dl-app 이고
#     .github/workflows/publish-ghcr.yml 이 그 저장소에서 실행되어 이미지가 올라갔다면
#   APP_IMAGE=ghcr.io/OWNER/csv-dl-app
#
# 주의: GHCR에 올라간 패키지는 기본적으로 비공개일 수 있다. 학생이 로그인 없이
#       내려받을 수 있도록 GitHub 저장소의 Packages 설정에서 이미지를 Public으로 바꿔야 한다.
#
# 아래 값은 예시이며 실제로 존재하는 이미지가 아니므로 그대로 두면 실행되지 않는다.
APP_IMAGE=ghcr.io/OWNER/csv-dl-app

# 선택 항목 - 보통은 그대로 두면 된다.
# CPU 이미지 태그 (기본값 cpu)
APP_IMAGE_TAG=cpu
# GPU 이미지 태그 (기본값 gpu, 시작_GPU.bat에서만 사용)
APP_IMAGE_TAG_GPU=gpu
